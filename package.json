{
  "name": "next-start-kit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev-logger": "FORCE_COLOR=true next | pino-pretty -t -c -s \"level > '30'\" next dev",
    "env-dev": "env-cmd -f .env.development next dev",
    "env-local": "env-cmd -f .env.local next dev",
    "env-prod": "env-cmd -f .env.production next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "check": "biome check",
    "turbopack": "next build --turbopack",
    "precommit": "echo 'pre-commit checks...' && exit 0",
    "release": "standard-version"
  },
  "pre-commit": [
    "precommit",
    "lint"
  ],
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@rive-app/react-canvas": "^4.31.0",
    "@tanstack/query-core": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-query-next-experimental": "^5.101.4",
    "cookies": "^0.9.1",
    "cookies-next": "^6.1.1",
    "dayjs": "^1.11.21",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.3.0",
    "next-client-cookies": "^2.1.1",
    "next-international": "^1.3.1",
    "next-logger": "^5.0.2",
    "next-yak": "^9.7.0",
    "ofetch": "^1.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "env-cmd": "^11.0.0",
    "globals": "^17.10.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "pino-smart": "^0.0.9",
    "postcss": "^8.5.26",
    "pre-commit": "^2.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
